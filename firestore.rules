rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidDownloadHistory(data) {
      return data.keys().hasAll(['id', 'userId', 'title', 'url', 'createdAt']) &&
        data.keys().size() <= 15 &&
        data.id is string && data.id.size() <= 128 &&
        data.userId is string && data.userId == request.auth.uid &&
        data.title is string && data.title.size() <= 500 &&
        data.url is string && data.url.size() <= 2048 &&
        (!data.keys().hasAny(['type']) || (data.type is string && data.type.size() <= 32)) &&
        (!data.keys().hasAny(['quality']) || (data.quality is string && data.quality.size() <= 32)) &&
        (!data.keys().hasAny(['format']) || (data.format is string && data.format.size() <= 32)) &&
        (!data.keys().hasAny(['isFavorite']) || (data.isFavorite is bool)) &&
        (!data.keys().hasAny(['taskId']) || (data.taskId is string && data.taskId.size() <= 128)) &&
        (!data.keys().hasAny(['downloadUrl']) || (data.downloadUrl is string && data.downloadUrl.size() <= 2048)) &&
        data.createdAt is string && data.createdAt.size() <= 64;
    }

    function isValidUserSettings(data) {
      return data.keys().hasAll(['userId', 'updatedAt']) &&
        data.keys().size() <= 20 &&
        data.userId is string && data.userId == request.auth.uid &&
        data.updatedAt is string && data.updatedAt.size() <= 64 &&
        (!data.keys().hasAny(['defaultType']) || (data.defaultType is string && data.defaultType.size() <= 32)) &&
        (!data.keys().hasAny(['defaultQuality']) || (data.defaultQuality is string && data.defaultQuality.size() <= 32)) &&
        (!data.keys().hasAny(['defaultFormat']) || (data.defaultFormat is string && data.defaultFormat.size() <= 32)) &&
        (!data.keys().hasAny(['saveFolderPrefix']) || (data.saveFolderPrefix is string && data.saveFolderPrefix.size() <= 64)) &&
        (!data.keys().hasAny(['defaultRateLimit']) || (data.defaultRateLimit is string && data.defaultRateLimit.size() <= 32)) &&
        (!data.keys().hasAny(['autoSaveToDownloads']) || (data.autoSaveToDownloads is bool)) &&
        (!data.keys().hasAny(['playNotificationSound']) || (data.playNotificationSound is bool)) &&
        (!data.keys().hasAny(['browserNotifications']) || (data.browserNotifications is bool)) &&
        (!data.keys().hasAny(['autoClearOnFinish']) || (data.autoClearOnFinish is bool)) &&
        (!data.keys().hasAny(['speedGraphEnabled']) || (data.speedGraphEnabled is bool)) &&
        (!data.keys().hasAny(['bdixFirstSpeed']) || (data.bdixFirstSpeed is bool)) &&
        (!data.keys().hasAny(['batchConcurrency']) || (data.batchConcurrency is number)) &&
        (!data.keys().hasAny(['maxFileSizeGb']) || (data.maxFileSizeGb is number));
    }

    match /users/{userId}/downloads/{downloadId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(downloadId) && isValidId(userId) && isValidDownloadHistory(incoming()) && incoming().userId == userId;
      allow update: if isOwner(userId) && isValidId(downloadId) && isValidId(userId) && isValidDownloadHistory(incoming()) && incoming().userId == existing().userId && incoming().id == existing().id;
      allow delete: if isOwner(userId) && isValidId(downloadId) && isValidId(userId);
    }

    match /users/{userId}/profile/settings {
      allow get: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidUserSettings(incoming()) && incoming().userId == userId;
      allow delete: if isOwner(userId);
    }
  }
}
